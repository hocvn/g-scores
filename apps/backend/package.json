{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm run dev:compile\" \"pnpm run dev:serve\"",
    "dev:compile": "tsc --watch --preserveWatchOutput",
    "dev:serve": "node --env-file=.env --watch dist/main.js",
    "build": "tsc",
    "start": "node --env-file=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma skills sync || exit 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "concurrently": "^10.0.7",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  }
}
